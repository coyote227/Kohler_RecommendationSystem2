# Required for live AI responses in the "Ask AI" panel.
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional. Choose a model available in your OpenRouter account.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional metadata sent to OpenRouter. Do not include a trailing slash.
APP_URL=http://localhost:5138
OPENROUTER_APP_TITLE=KOHLER AI Bathroom Designer
